rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    match /connectionChecks/{uid} {
      allow read, write: if isUser(uid);
    }

    match /rooms/{roomCode} {
      allow create: if signedIn()
        && request.resource.data.hostUid == request.auth.uid;

      allow read: if signedIn()
        && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid));

      allow update, delete: if signedIn()
        && resource.data.hostUid == request.auth.uid;

      match /players/{uid} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid));

        allow create, update, delete: if isUser(uid);
      }

      match /rounds/{roundNumber} {
        allow read: if signedIn()
          && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid));

        allow write: if signedIn()
          && get(/databases/$(database)/documents/rooms/$(roomCode)).data.hostUid == request.auth.uid;

        match /answers/{uid} {
          allow read: if signedIn()
            && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid));

          allow create, update: if isUser(uid)
            && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "playing";
        }

        match /verdicts/{verdictId} {
          allow read: if signedIn()
            && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid));

          allow write: if signedIn()
            && exists(/databases/$(database)/documents/rooms/$(roomCode)/players/$(request.auth.uid))
            && get(/databases/$(database)/documents/rooms/$(roomCode)).data.status == "reviewing";
        }
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
